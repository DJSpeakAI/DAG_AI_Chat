{
  "app": {
    "bundleName": "com.dagaichat.app",
    "vendor": "example",
    "versionCode": 1000217, // ★ 0.222.14：右键/长按「指哪打哪」——被右键/长按的边栏文件夹行即时高亮（onMouse Right Press + LongPress 设 focusTreeId，菜单项/切视图后清除，PC 右键/Pad/手机长按三端同效）+复制目标选择器放开（复制不再隐藏源文件夹自身/子孙——复制自己=变成自己的子文件夹，copyFolder 去目标==自身拒绝）；所有小三角再大一圈（导航条/边栏树/移动复制弹窗树 13→16、宽 18→22 三端统一）；边栏把手更细更长（宽 8→7、高 56→112）；0.222.13：根目录「全部卡片」行补 PC 右键/Pad 手机长按菜单（4 项裁剪版）+复制到子孙放开；0.222.12：手机/Pad 边栏与 PC 统一——知识库页抽屉显示「导航」折叠条+文件夹树触摸长按弹 6 项菜单；0.222.11：手机设备类型兜底；0.222.10：知识库手机抽屉空隙修复；0.222.9：关于页 UI 卡片化重排+版权行；0.220.1：边栏双区块独立收放；0.219.2：单词库视图模式跨页面记忆+知识库文件夹内新建卡片归当前文件夹
    "versionName": "1.0.0",
    "buildVersion": "1",
    // ★ 0.165.1：接入云空间端云数据同步——true 后「设置-云空间」出现应用开关；
    // debug 证书连开发环境（AGC 云侧容器/数据类型配置就绪后同步生效）
    "cloudStructuredDataSyncEnabled": true,
    "icon": "$media:layered_image", // ★ 0.177.0：IDE 警告「请使用分层图标」修复——icon 从普通 PNG（app_logo.png）改指 layered_image.json（background=新 logo 深紫版 + foreground 透明层）；app_logo.png 与 background.png 本就是同一张深紫版图（121489 字节一致），桌面图标视觉零变化
    "label": "$string:app_name"
  }
}
