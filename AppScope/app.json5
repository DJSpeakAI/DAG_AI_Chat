{
  "app": {
    "bundleName": "com.dagaichat.app",
    "vendor": "example",
    "versionCode": 1000216, // ★ 0.222.13：根目录「全部卡片」行补 PC 右键/Pad 手机长按菜单（4 项裁剪版=新建卡片/新建文件夹/复制/删除，无移动/无重命名；删除=清空根下全部内容保留入口；复制=根全部内容到子文件夹）+复制到子孙文件夹放开（children 快照前置根治 0.221.5 ANR）；0.222.12：手机/Pad 边栏与 PC 统一——知识库页抽屉显示「导航」折叠条（去 wideScreen 限制）+文件夹树触摸长按弹 6 项菜单（LongPressGesture+bindPopup 双通道，PC 右键不变）；0.222.11：手机设备类型兜底（deviceType='phone' 恒手机模式，治 600.6vp 断点踩线误判平板）；0.222.10：知识库手机抽屉空隙修复（包裹 Stack+边栏列 height 100%，Blank 弹性复位+全屏贴满）；0.222.9：关于页 UI 卡片化重排+版权行；0.220.1：边栏双区块独立收放（导航条/文件夹树各自 toggle+记忆）；0.219.2：单词库视图模式跨页面记忆（AppStorageV2）+知识库文件夹内新建卡片归当前文件夹（bug 根治）
    "versionName": "1.0.0",
    "buildVersion": "1",
    // ★ 0.165.1：接入云空间端云数据同步——true 后「设置-云空间」出现应用开关；
    // debug 证书连开发环境（AGC 云侧容器/数据类型配置就绪后同步生效）
    "cloudStructuredDataSyncEnabled": true,
    "icon": "$media:layered_image", // ★ 0.177.0：IDE 警告「请使用分层图标」修复——icon 从普通 PNG（app_logo.png）改指 layered_image.json（background=新 logo 深紫版 + foreground 透明层）；app_logo.png 与 background.png 本就是同一张深紫版图（121489 字节一致），桌面图标视觉零变化
    "label": "$string:app_name"
  }
}
