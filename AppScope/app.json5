{
  "app": {
    "bundleName": "com.example.dag_ai_chat",
    "vendor": "example",
    "versionCode": 1000019, // ★ 0.167.8：versionCode+1（分段控件等高对齐+小屏标题统计加回+返回箭头左移+画布改平铺+删设置画布Tab+切换锁死bugfix+app图标换新LOGO）
    "versionName": "1.0.0",
    "buildVersion": "1",
    // ★ 0.165.1：接入云空间端云数据同步——true 后「设置-云空间」出现应用开关；
    // debug 证书连开发环境（AGC 云侧容器/数据类型配置就绪后同步生效）
    "cloudStructuredDataSyncEnabled": true,
    "icon": "$media:app_logo",
    "label": "$string:app_name"
  }
}
