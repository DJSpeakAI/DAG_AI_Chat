{
  "app": {
    "signingConfigs": [
      {
        "name": "default",
        "type": "HarmonyOS",
        "material": {
          "certpath": "./signing/default_dag_ai_chat.cer",
          "keyAlias": "dagai_debug_key",
          "keyPassword": "Dagai2026!Dagai2026!Dagai2026!!",
          "profile": "./signing/dag_ai_chat_debugDebug.p7b", // ★ 包名切换（2026-10-10）：新三件套（com.dagaichat.app，app-identifier=6917618685526149144）；密码=32字符明文（hvigor 只查长度≥32，密文格式免了）
          "signAlg": "SHA256withECDSA",
          "storeFile": "./signing/default_dag_ai_chat.p12",
          "storePassword": "Dagai2026!Dagai2026!Dagai2026!!"
        }
      }
    ],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "targetSdkVersion": "26.0.0",
        "compatibleSdkVersion": "6.1.1(24)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug",
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}